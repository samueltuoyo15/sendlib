# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/send-lib?retryWrites=true&w=majority

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your_jwt_secret_hex_string
ENCRYPTION_KEY=your_64_char_encryption_key_hex

# Google OAuth (Auth + Gmail Relay)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/gmail/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Paystack Billing (Recurring Subscriptions)
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_PLAN_CODE=PLN_...
# Expected Pro payment (kobo); keep aligned with your actual Paystack plan.
PAYSTACK_PRO_AMOUNT_KOBO=400000
PAYSTACK_PRO_CURRENCY=NGN

# Public Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# System Emails (via Sendlib Dogfooding)
SENDLIB_API_KEY=sl_...
SENDLIB_FROM="Sendlib" <youremail@gmail.com>
